#!/usr/bin/env bash
# hooks/post-commit — relay-aware verify hook (HARD tier only, v1)
#
# Design: docs/meeting-notes/2026-06-16-0635-relay-aware-commit-hook.md (D1–D6)
#
# Invariants:
#   1. .mw is OPTIONAL — if unreachable/errors, HARD tier no-ops; commit ALWAYS succeeds.
#   2. NEVER calls an LLM — deterministic only (the SOFT/LLM tier lives in /relay review).
#   3. Relay-skip — RELAY_SKIP=1 (authoritative) or /worktrees/ in git-dir → no-op (no note).
#   4. HARD tier reads verify/mirror/resogram_esol.mw via mathematical_writing.dag.stale_after_edit.
#
# The hook's exit code is ignored by git (post-commit), so it can never block a commit.
#
# id:ac7b (2026-09-07): the HARD tier now reads the COMMITTED DIFF of the mirror
# (parent-commit content vs this commit's content) and runs `stale_after_edit` on the
# real before/after, instead of always simulating an edit to the same hardcoded `e`
# definition. A commit that doesn't touch the mirror produces an explicit "none
# (mirror unchanged in this commit)" finding with zero parsing/probing cost; a commit
# that does touch it produces a finding that is a function of what actually changed,
# so two commits editing different sections now yield different findings strings.
#
# Note-lifecycle field (`status:pending`): NOT deleted — a consumer IS planned, just
# not yet built: the `/relay review` triage pass (routed:6cc0) and the `/relay human`
# owner-verdict pass (routed:f42b) are the two designed consumers of the
# pending→triaged→processed transition (docs/meeting-notes/2026-06-16-0635-relay-aware-commit-hook.md
# D4/D5). Building those passes is out of this tooling-only hook's scope; this fix
# addresses the OTHER half of id:ac7b (the constant-probe finding), which was the part
# actually reachable from `hooks/post-commit` alone.

set -u

NOTES_REF="refs/notes/verify"
MW_REPO="${MW_REPO:-/home/tobias/src/mathematical-writing}"
MIRROR="verify/mirror/resogram_esol.mw"

# --- relay-skip check -------------------------------------------------------
# RELAY_SKIP=1 is authoritative. No note is written in relay context.
if [ "${RELAY_SKIP:-}" = "1" ]; then
  exit 0
fi
# Fallback: detect linked-worktree git-dir (contains /worktrees/).
git_dir=$(git rev-parse --git-dir 2>/dev/null || true)
case "$git_dir" in
  *"/worktrees/"*) exit 0 ;;
esac

# --- HARD tier: run DAG staleness over the .mw mirror (optional) -----------
repo_root=$(git rev-parse --show-toplevel 2>/dev/null || true)
mirror="$repo_root/$MIRROR"
hard_status="skipped"
findings=""

if ! command -v uv >/dev/null 2>&1 || [ ! -d "$MW_REPO" ]; then
  hard_status="skipped: .mw unavailable"
elif [ ! -f "$mirror" ]; then
  hard_status="skipped: mirror not found"
else
  new_mirror_content=$(cat "$mirror" 2>/dev/null || true)
  parent=$(git rev-parse HEAD^ 2>/dev/null || true)
  if [ -n "$parent" ]; then
    old_mirror_content=$(git show "$parent:$MIRROR" 2>/dev/null || true)
  else
    old_mirror_content=""
  fi

  if [ "$old_mirror_content" = "$new_mirror_content" ]; then
    # The commit didn't touch the mirror at all — nothing to probe, and no .mw
    # invocation needed (this is the "finding is a function of the commit" fix:
    # a commit unrelated to the mirror now gets an explicit non-finding instead
    # of the old constant-probe result).
    hard_status="ok"
    findings="none (mirror unchanged in this commit)"
  else
    old_b64=$(printf '%s' "$old_mirror_content" | base64 | tr -d '\n')
    new_b64=$(printf '%s' "$new_mirror_content" | base64 | tr -d '\n')
    hard_findings=$(OLD_MIRROR_B64="$old_b64" NEW_MIRROR_B64="$new_b64" uv run --quiet --project "$MW_REPO" python - <<'PY' 2>/dev/null
import base64, os, sys
try:
    from mathematical_writing.parser import parse
    from mathematical_writing.dag import stale_after_edit
except ImportError:
    print("skipped: import error")
    sys.exit(0)

old_src = base64.b64decode(os.environ.get("OLD_MIRROR_B64", "")).decode("utf-8", "replace")
new_src = base64.b64decode(os.environ.get("NEW_MIRROR_B64", "")).decode("utf-8", "replace")

try:
    old_frags = parse(old_src) if old_src.strip() else []
    new_frags = parse(new_src)
except Exception:
    print("skipped: mirror parse error")
    sys.exit(0)

# Real before/after of THIS commit's mirror content — not a simulated probe —
# so the finding reflects what the commit actually changed.
stale = stale_after_edit(old_frags, new_frags)

if stale:
    print(f"stale handles after commit edit: {sorted(stale)}")
else:
    print("none")
PY
) || true

    if [ -z "$hard_findings" ]; then
      hard_status="skipped: .mw error"
    else
      case "$hard_findings" in
        "skipped:"*)
          hard_status="$hard_findings"
          ;;
        *)
          hard_status="ok"
          findings="$hard_findings"
          ;;
      esac
    fi
  fi
fi

# --- Write the status:pending note (append-only, never deletes) -------------
sha=$(git rev-parse HEAD 2>/dev/null || echo "unknown")
note_body="status:pending
hook=post-commit tier=HARD ts=$(date -u +%Y-%m-%dT%H:%M:%SZ) sha=$sha hard_tier=$hard_status"
if [ -n "$findings" ]; then
  note_body="$note_body
findings=$findings"
fi

git notes --ref="$NOTES_REF" append -m "$note_body" HEAD 2>/dev/null || true

exit 0
